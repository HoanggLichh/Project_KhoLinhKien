@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div class="d-flex align-items-center gap-3">
@if (SignInManager.IsSignedIn(User))
{
    <span class="small"><i class="bi bi-person-circle"></i> @User.Identity?.Name</span>
    <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-sm btn-accent">Đăng xuất</button>
    </form>
}
else
{
    <a class="btn btn-sm btn-accent" asp-controller="Account" asp-action="Login">Đăng nhập</a>
}
</div>