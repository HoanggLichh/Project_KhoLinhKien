                                            <button type="submit" class="acc-btn danger"><i class="bi bi-trash3"></i> Gỡ</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="gear-row">
                            <div class="gear-txt"><b>Giao diện</b><small>Chọn nền tối hoặc sáng</small></div>
