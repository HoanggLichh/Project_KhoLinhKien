@{
    var daDangNhap = User.Identity!.IsAuthenticated;
    var quyenKho = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");
    var vaiTro = User.IsInRole("QuanLy") ? "Quản lý" : User.IsInRole("ThuKho") ? "Thủ kho" : User.IsInRole("KyThuatVien") ? "Kỹ thuật viên" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - L-Inventory</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(daDangNhap ? "app" : "guest")">

@if (daDangNhap)
{
    <aside class="sidebar" id="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><i class="bi bi-cpu-fill"></i> L-INVENTORY</a>

                <nav class="side-nav">
            <a class="side-link" asp-controller="Home" asp-action="Index"><i class="bi bi-pie-chart-fill"></i> Tổng quan</a>
            <a class="side-link" asp-controller="LinhKien" asp-action="Index"><i class="bi bi-motherboard"></i> Quản lý linh kiện</a>
            <a class="side-link" asp-controller="DonSuaChua" asp-action="Index"><i class="bi bi-wrench-adjustable"></i> Đơn sửa chữa</a>

            @if (quyenKho)
            {
                <a class="side-link" asp-controller="LoaiLinhKien" asp-action="Index"><i class="bi bi-tags-fill"></i> Loại linh kiện</a>
                <a class="side-link" asp-controller="NhaCungCap" asp-action="Index"><i class="bi bi-truck"></i> Nhà cung cấp</a>
                <a class="side-link" asp-controller="ViTriKho" asp-action="Index"><i class="bi bi-boxes"></i> Vị trí lưu kho</a>
                <a class="side-link" asp-controller="PhieuNhap" asp-action="Index"><i class="bi bi-box-arrow-in-down"></i> Phiếu nhập kho</a>
            }

            <a class="side-link" asp-controller="Home" asp-action="GioiThieu"><i class="bi bi-info-circle-fill"></i> Giới thiệu</a>
        </nav>

        <form class="side-logout" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="side-link logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
        </form>
    </aside>

    <div class="content">
        <header class="topbar">
            <button type="button" class="toggle-btn" id="sidebarToggle" aria-label="Mở menu"><i class="bi bi-list"></i></button>
            <div class="topbar-title">Hệ thống quản lý nội bộ</div>
            <div class="topbar-right">
                <i class="bi bi-bell-fill bell"></i>
                <div class="user">
                    <i class="bi bi-person-circle"></i>
                    <div class="user-text">
                        <b>@User.Identity.Name</b>
                        <small>@vaiTro</small>
                    </div>
                </div>
            </div>
        </header>

        <main class="main-area">
            <div class="main-card">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="guest-area">
        @RenderBody()
    </main>
}

    @if (TempData["ThongBao"] is string tbOk || TempData["Loi"] is string tbErr)
    {
        <div class="toast-stack">
            @if (TempData["ThongBao"] is string okMsg)
            {
                <div class="toast-msg ok"><i class="bi bi-check-circle-fill"></i><span>@okMsg</span></div>
            }
            @if (TempData["Loi"] is string errMsg)
            {
                <div class="toast-msg err"><i class="bi bi-exclamation-triangle-fill"></i><span>@errMsg</span></div>
            }
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
            <script>
        (function () {
            // Nút mở sidebar trên màn hình nhỏ
            var btn = document.getElementById('sidebarToggle');
            if (btn) btn.addEventListener('click', function () { document.body.classList.toggle('sidebar-open'); });

            var path = location.pathname.toLowerCase().replace(/\/$/, '') || '/';

            document.querySelectorAll('.side-nav .side-link').forEach(function (a) {
                // Tự sáng mục đang mở
                var href = (a.getAttribute('href') || '').toLowerCase().replace(/\/$/, '');
                if (href === '') href = '/';
                var match = (href === '/' && (path === '/' || path === '/home' || path === '/home/index'))
                         || (href !== '/' && href !== '#' && (path === href || path.indexOf(href + '/') === 0));
                if (match) a.classList.add('active');

                // Hiệu ứng gợn sóng khi nhấp (không chặn việc chuyển trang)
                a.addEventListener('mousedown', function (e) {
                    if (a.classList.contains('disabled')) return;
                    var r = a.getBoundingClientRect();
                    var s = document.createElement('span');
                    s.className = 'ripple';
                    s.style.left = (e.clientX - r.left) + 'px';
                    s.style.top = (e.clientY - r.top) + 'px';
                    a.appendChild(s);
                    setTimeout(function () { s.remove(); }, 600);
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>