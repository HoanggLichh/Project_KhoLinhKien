@using System.Security.Claims
@inject IWebHostEnvironment Env
@{
    var daDangNhap = User.Identity!.IsAuthenticated;
    var quyenKho = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");
    var vaiTro = User.IsInRole("QuanLy") ? "Quản lý"
            : User.IsInRole("ThuKho") ? "Thủ kho"
            : User.IsInRole("KyThuatVien") ? "Kỹ thuật viên" : "";
    var laDashboard = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "") == "Home"
               && (ViewContext.RouteData.Values["action"]?.ToString() ?? "") == "Index";

    // Ảnh đại diện: wwwroot/avatars/{Id tài khoản}.jpg|png|webp
    string? avatarUrl = null;
    var avatarUid = System.IO.Path.GetFileName(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "");
    if (daDangNhap && avatarUid != "")
    {
        foreach (var ex in new[] { ".jpg", ".png", ".webp" })
        {
            var fp = System.IO.Path.Combine(Env.WebRootPath, "avatars", avatarUid + ex);
            if (System.IO.File.Exists(fp))
            {
                avatarUrl = "/avatars/" + avatarUid + ex + "?v=" + System.IO.File.GetLastWriteTimeUtc(fp).Ticks;
                break;
            }
        }
    }
    var chuCai = string.IsNullOrEmpty(User.Identity?.Name) ? "?" : User.Identity!.Name!.Substring(0, 1).ToUpper();
    var backUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - L-Inventory</title>

    <script>
        (function () {
            var t = 'dark';
            try { t = localStorage.getItem('theme') || 'dark'; } catch (e) { }
            document.documentElement.setAttribute('data-theme', t);
            document.documentElement.setAttribute('data-bs-theme', t);
            try { if (localStorage.getItem('motion') === 'off') document.documentElement.classList.add('no-motion'); } catch (e) { }
            // Menu: mặc định mở trên máy tính, nhớ trạng thái giữa các trang, không chạy hiệu ứng khi vừa tải
            try {
                if (window.innerWidth > 767 && localStorage.getItem('menu') !== 'closed')
                    document.documentElement.classList.add('mm-open');
            } catch (e) { }
            document.documentElement.classList.add('mm-init');
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Nunito:wght@600;700;800;900&family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/redesign.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu-push.css" asp-append-version="true" />
    @* Giữ ảnh đại diện luôn nhỏ gọn, kể cả khi redesign.css chưa cập nhật *@
    <style>
        .av { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; }
        .av.av-lg { width: 48px; height: 48px; }
        .av img { width: 100%; height: 100%; max-width: 100%; object-fit: cover; display: block; }
    </style>
</head>
<body class="@(daDangNhap ? "app" : "guest")">

@if (daDangNhap)
{
