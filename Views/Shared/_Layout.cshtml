                                <button type="button" data-theme-set="dark"><i class="bi bi-moon-stars-fill"></i> Tối</button>
                                <button type="button" data-theme-set="light"><i class="bi bi-sun-fill"></i> Sáng</button>
                            </div>
                        </div>

                        <div class="gear-row">
                            <div class="gear-txt"><b>Hiệu ứng chuyển động</b><small>Tắt nếu máy bị chậm</small></div>
                            <button type="button" class="gear-switch" id="motionSwitch" role="switch" aria-checked="true" aria-label="Hiệu ứng chuyển động"><span></span></button>
                        </div>
                    </div>
                </div>

                <div class="user-menu" id="userMenu">
    <button type="button" class="user" id="userBtn" aria-haspopup="true" aria-expanded="false">
        <span class="av">@if (avatarUrl != null) { <img src="@avatarUrl" alt="" /> } else { <text>@chuCai</text> }</span>
        <div class="user-text">
            <b>@User.Identity!.Name</b>
            <small>@vaiTro</small>
        </div>
        <i class="bi bi-chevron-down user-caret"></i>
    </button>

    <div class="user-panel" id="userPanel" role="menu" aria-label="Tài khoản">
        <div class="up-head">
            <span class="av av-lg">@if (avatarUrl != null) { <img src="@avatarUrl" alt="" /> } else { <text>@chuCai</text> }</span>
            <div class="up-info">
                <b>@User.Identity!.Name</b>
                <span class="up-role"><i class="bi bi-patch-check-fill"></i> @vaiTro</span>
            </div>
        </div>
        <a class="up-link" asp-controller="HoSo" asp-action="Index" role="menuitem"><i class="bi bi-person-gear"></i> Chỉnh sửa tài khoản</a>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="up-logout" role="menuitem">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </button>
        </form>
    </div>
</div>
            </div>
        </header>

        <main class="main-area">
            <div class="main-card">
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="guest-area">
        @RenderBody()
    </main>
}

    @if (TempData["ThongBao"] != null || TempData["Loi"] != null)
    {
        <div class="toast-stack">
            @if (TempData["ThongBao"] is string okMsg)
            {
                <div class="toast-msg ok"><i class="bi bi-check-circle-fill"></i><span>@okMsg</span></div>
            }
            @if (TempData["Loi"] is string errMsg)
            {
                <div class="toast-msg err"><i class="bi bi-exclamation-triangle-fill"></i><span>@errMsg</span></div>
            }
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var path = location.pathname.toLowerCase().replace(/\/$/, '') || '/';

            document.querySelectorAll('.mm-link').forEach(function (a) {
                var href = (a.getAttribute('href') || '').toLowerCase().replace(/\/$/, '');
                if (href === '') href = '/';
                var match = (href === '/' && (path === '/' || path === '/home' || path === '/home/index'))
                        || (href !== '/' && href !== '#' && (path === href || path.indexOf(href + '/') === 0));
                if (match) a.classList.add('active');
            });

            // ----- Menu trượt: mở thì đẩy nội dung trang sang bên -----
            var mm = document.getElementById('mm'), mmBtn = document.getElementById('mmBtn'), mmPanel = document.getElementById('mmPanel');
            if (mm && mmBtn && mmPanel) {
                var de = document.documentElement;
                var isMobile = function () { return window.innerWidth <= 767; };
                var mmSet = function (open, save) {
                    mm.classList.toggle('open', open);
                    de.classList.toggle('mm-open', open);
                    mmBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                    mmBtn.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
                    if (save && !isMobile()) { try { localStorage.setItem('menu', open ? 'open' : 'closed'); } catch (e) { } }
                };

                // Đồng bộ trạng thái ban đầu rồi bật lại hiệu ứng (để trang không bị "thụt" khi vừa tải)
                mmSet(de.classList.contains('mm-open'), false);
                requestAnimationFrame(function () { requestAnimationFrame(function () { de.classList.remove('mm-init'); }); });

                // Chỉ nút ☰ mới đóng/mở menu; bấm vào mục thì menu giữ nguyên
                mmBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    mmSet(!de.classList.contains('mm-open'), true);
                });
                mmPanel.addEventListener('click', function (e) { e.stopPropagation(); });

                // Chỉ trên điện thoại (menu che cả trang) mới tự đóng khi bấm ra ngoài / Esc
                document.addEventListener('click', function () { if (isMobile()) mmSet(false, false); });
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && isMobile()) mmSet(false, false); });
            }

            // ----- Menu tài khoản (góc phải) -----
            var uBtn = document.getElementById('userBtn'), uPanel = document.getElementById('userPanel'), uWrap = document.getElementById('userMenu');
            if (uBtn && uPanel) {
                var uClose = function () { uPanel.classList.remove('open'); uBtn.setAttribute('aria-expanded', 'false'); };
                uBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var open = uPanel.classList.toggle('open');
                    uBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                document.addEventListener('click', function (e) { if (!uWrap.contains(e.target)) uClose(); });
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') uClose(); });
            }

            var nBtn = document.getElementById('notifBtn'),
                nPanel = document.getElementById('notifPanel'),
                nBadge = document.getElementById('notifBadge'),
                nAll = document.getElementById('notifReadAll');
            if (nBtn && nPanel) {
                var nCount = function () {
                    var n = nPanel.querySelectorAll('.notif-item.unread').length;
                    nBadge.textContent = n;
                    nBadge.style.display = n > 0 ? '' : 'none';
                };
                var nClose = function () {
                    nPanel.classList.remove('open');
                    nBtn.setAttribute('aria-expanded', 'false');
                };
                nBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var open = nPanel.classList.toggle('open');
                    nBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                nPanel.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var it = e.target.closest('.notif-item');
                    if (it) { it.classList.remove('unread'); nCount(); }
                });
                nAll.addEventListener('click', function () {
                    nPanel.querySelectorAll('.notif-item.unread').forEach(function (i) { i.classList.remove('unread'); });
                    nCount();
                });
                document.addEventListener('click', nClose);
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') nClose(); });
                nCount();
            }
        })();
    </script>

    <script>
        (function () {
            var SHAPE = 'circle';
            var root = document.documentElement;
            function set(k, v) { try { localStorage.setItem(k, v); } catch (e) { } }

            var segBtns = document.querySelectorAll('#themeSeg [data-theme-set]');
            var motionSw = document.getElementById('motionSwitch');

            function applyTheme(t) {
                root.setAttribute('data-theme', t);
                root.setAttribute('data-bs-theme', t);
                var icon = document.getElementById('theme-icon');
                if (icon) icon.className = 'bi ' + (t === 'dark' ? 'bi-sun-fill' : 'bi-moon-stars-fill') + ' bell';
                segBtns.forEach(function (b) { b.classList.toggle('on', b.dataset.themeSet === t); });
                set('theme', t);
            }

            function applyMotion(on) {
                root.classList.toggle('no-motion', !on);
                set('motion', on ? 'on' : 'off');
                if (motionSw) { motionSw.setAttribute('aria-checked', on ? 'true' : 'false'); motionSw.classList.toggle('on', on); }
            }

            function poly(name, cx, cy, s) {
                var N = 72, pts = [];
                for (var i = 0; i < N; i++) {
                    var a = i / N * Math.PI * 2, px, py, r;
                    if (name === 'heart') {
                        var hx = 16 * Math.pow(Math.sin(a), 3);
                        var hy = -(13 * Math.cos(a) - 5 * Math.cos(2 * a) - 2 * Math.cos(3 * a) - Math.cos(4 * a));
                        px = cx + hx / 17 * s;
                        py = cy + (hy - 2.5) / 17 * s;
                    } else {
                        if (name === 'diamond') r = 1 / (Math.abs(Math.cos(a)) + Math.abs(Math.sin(a)));
                        else if (name === 'square') r = 1 / Math.max(Math.abs(Math.cos(a)), Math.abs(Math.sin(a)));
                        else if (name === 'hexagon') r = Math.cos(Math.PI / 6) / Math.cos((a % (Math.PI / 3)) - Math.PI / 6);
                        else if (name === 'star') {
                            var seg = Math.PI * 2 / 5;
                            var u = ((a + Math.PI / 2) % seg) / seg;
                            r = 0.45 + 0.55 * Math.abs(u - 0.5) * 2;
                        } else r = 1;
                        px = cx + Math.cos(a) * r * s;
                        py = cy + Math.sin(a) * r * s;
                    }
                    pts.push(px.toFixed(1) + 'px ' + py.toFixed(1) + 'px');
                }
                return 'polygon(' + pts.join(',') + ')';
            }

            function switchTheme(next, origin) {
                var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || root.classList.contains('no-motion');
                if (!document.startViewTransition || reduce || !origin) { applyTheme(next); return; }

                var r = origin.getBoundingClientRect();
                var x = r.left + r.width / 2, y = r.top + r.height / 2;
                var radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

                var t = document.startViewTransition(function () { applyTheme(next); });
                t.ready.then(function () {
                    var big = radius * ((SHAPE === 'star' || SHAPE === 'heart') ? 2.4 : 1.5);
                    root.animate(
                        [
                            { clipPath: poly(SHAPE, x, y, 0),   offset: 0,   easing: 'cubic-bezier(.3, 1.5, .5, 1)' },
                            { clipPath: poly(SHAPE, x, y, 70),  offset: .22, easing: 'ease-in-out' },
                            { clipPath: poly(SHAPE, x, y, 32),  offset: .38, easing: 'cubic-bezier(.65, 0, .15, 1)' },
                            { clipPath: poly(SHAPE, x, y, big), offset: 1 }
                        ],
                        { duration: 1300, pseudoElement: '::view-transition-new(root)' }
                    );
                }).catch(function () { });
            }

            applyTheme(root.getAttribute('data-theme') || 'dark');
            applyMotion(!root.classList.contains('no-motion'));

            document.addEventListener('click', function (e) {
                var btn = e.target.closest('#theme-toggle');
                if (!btn) return;
                e.stopImmediatePropagation();
                e.preventDefault();
                switchTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark', btn);
            }, true);

            segBtns.forEach(function (b) {
                b.addEventListener('click', function () {
                    if (root.getAttribute('data-theme') !== b.dataset.themeSet) switchTheme(b.dataset.themeSet, b);
                });
            });
            if (motionSw) motionSw.addEventListener('click', function () { applyMotion(root.classList.contains('no-motion')); });

            var gBtn = document.getElementById('gearBtn'), gPanel = document.getElementById('gearPanel'), gWrap = document.getElementById('gear');
            if (gBtn && gPanel) {
                var gClose = function () { gPanel.classList.remove('open'); gBtn.setAttribute('aria-expanded', 'false'); };
                gBtn.addEventListener('click', function () {
                    var open = gPanel.classList.toggle('open');
                    gBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
                document.addEventListener('click', function (e) { if (!gWrap.contains(e.target)) gClose(); });
                document.addEventListener('keydown', function (e) { if (e.key === 'Escape') gClose(); });
            }

            var avIn = document.getElementById('avatarInput');
            if (avIn) avIn.addEventListener('change', function () {
                var f = avIn.files[0];
                if (!f) return;
                if (f.size > 2 * 1024 * 1024) { alert('Ảnh tối đa 2 MB.'); avIn.value = ''; return; }
                document.getElementById('avatarForm').submit();
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    var s = document.getElementById('globalSearch');
                    if (s) s.focus();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>