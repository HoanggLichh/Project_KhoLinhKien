@model KhoLinhKien.Models.DashboardVM
@{
    ViewData["Title"] = "Tổng quan";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var quyenKho = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");

    // Doanh thu tháng: rút gọn thành M / K cho vừa thẻ
    decimal dtSo; int dtDec; string dtHau;
    if (Model.DoanhThuThang >= 1_000_000m) { dtSo = Math.Round(Model.DoanhThuThang / 1_000_000m, 1); dtDec = 1; dtHau = "M"; }
    else if (Model.DoanhThuThang >= 1_000m) { dtSo = Math.Round(Model.DoanhThuThang / 1_000m, 0); dtDec = 0; dtHau = "K"; }
    else { dtSo = Model.DoanhThuThang; dtDec = 0; dtHau = "đ"; }
    var dtChu = dtSo.ToString("0.#", inv) + dtHau;

    // Biểu đồ 7 ngày
    var maxNgay = Model.Ngay7.Any() ? Model.Ngay7.Max(x => x.GiaTri) : 0m;
}

@if (!User.Identity!.IsAuthenticated)
{
    <div class="aurora" aria-hidden="true"><span></span><span></span></div>

    <section class="landing anim">
        <div class="landing-card">
            <svg class="landing-logo" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                    <linearGradient id="lgV2" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#5eead4" />
                        <stop offset="1" stop-color="#0f9b88" />
                    </linearGradient>
                </defs>
                <path class="pins" d="M17 4v6M24 4v6M31 4v6M17 38v6M24 38v6M31 38v6M4 17h6M4 24h6M4 31h6M38 17h6M38 24h6M38 31h6"
                      stroke="url(#lgV2)" stroke-width="2.4" stroke-linecap="round" />
                <rect x="10" y="10" width="28" height="28" rx="7" fill="#0b1f1c" stroke="url(#lgV2)" stroke-width="2.4" />
                <path d="M19 17v14h10" stroke="#fff" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
                <circle class="led" cx="30" cy="19" r="2.8" fill="#f43f5e" />
            </svg>

            <h1 class="landing-title"><em>L</em>-INVENTORY</h1>
            <p class="landing-sub">Hệ thống quản lý kho linh kiện điện tử<br />cho cửa hàng sửa chữa điện thoại</p>

            <a class="btn-login" asp-controller="Account" asp-action="Login">
                Đăng nhập <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <small class="landing-foot">Hệ thống nội bộ · Chỉ dành cho nhân viên cửa hàng</small>
    </section>
}
else
{
    <div class="aurora" aria-hidden="true"><span></span><span></span></div>

    <div class="hx-ticker anim" aria-hidden="true">
        <div class="hx-ticker-track">
            @for (int r = 0; r < 2; r++)
            {
                <span class="ok">● HỆ THỐNG TRỰC TUYẾN</span>
                <span>TỔNG TỒN KHO @Model.TongLinhKien.ToString("N0") LINH KIỆN</span>
                <span class="@(Model.SapHetHang > 0 ? "warn" : "ok")">@Model.SapHetHang LINH KIỆN CẦN NHẬP</span>
                <span>@Model.DonDangSua ĐƠN ĐANG SỬA</span>
                <span>@Model.DonHoanTat ĐƠN ĐÃ HOÀN THÀNH</span>
                <span>DOANH THU THÁNG @dtChu</span>
            }
        </div>
    </div>

    <div class="dash-head hx-head anim">
        <div>
            <div class="hx-eyebrow"><span class="hx-live"></span> TRỰC TUYẾN · <b id="hxClock">--:--:--</b></div>
            <h1>Dashboard <em>Tổng Quan</em></h1>
        </div>
        <span class="dash-date">Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
    </div>

    <!-- ===== 4 thẻ thống kê ===== -->
    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-3 anim" style="--d:.1s">
            <div class="hx-card c-blue">
                <div class="hx-card-top">
                    <div><div class="hx-label">Tổng linh kiện</div><div class="hx-value" data-count="@Model.TongLinhKien">0</div></div>
                    <div class="hx-icon"><i class="bi bi-boxes"></i></div>
                </div>
                <svg class="hx-spark" viewBox="0 0 120 36" preserveAspectRatio="none"><path pathLength="1" d="M0 28 L15 22 L30 25 L45 14 L60 18 L75 8 L90 12 L105 4 L120 6"/></svg>
            </div>
        </div>
        <div class="col-md-6 col-xl-3 anim" style="--d:.2s">
            <div class="hx-card c-red">
                <div class="hx-card-top">
                    <div><div class="hx-label">Sắp hết hàng</div><div class="hx-value" data-count="@Model.SapHetHang">0</div></div>
                    <div class="hx-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                </div>
                <svg class="hx-spark" viewBox="0 0 120 36" preserveAspectRatio="none"><path pathLength="1" d="M0 6 L15 10 L30 8 L45 16 L60 14 L75 22 L90 20 L105 28 L120 26"/></svg>
            </div>
        </div>
        <div class="col-md-6 col-xl-3 anim" style="--d:.3s">
            <div class="hx-card c-green">
                <div class="hx-card-top">
                    <div><div class="hx-label">Đơn hoàn thành</div><div class="hx-value" data-count="@Model.DonHoanTat">0</div></div>
                    <div class="hx-icon"><i class="bi bi-clipboard-check-fill"></i></div>
                </div>
                <svg class="hx-spark" viewBox="0 0 120 36" preserveAspectRatio="none"><path pathLength="1" d="M0 30 L15 26 L30 28 L45 20 L60 22 L75 14 L90 16 L105 8 L120 10"/></svg>
            </div>
        </div>
        <div class="col-md-6 col-xl-3 anim" style="--d:.4s">
            <div class="hx-card c-cyan">
                <div class="hx-card-top">
                    <div><div class="hx-label">Doanh thu tháng</div><div class="hx-value" data-count="@dtSo.ToString(inv)" data-dec="@dtDec" data-suffix="@dtHau">0</div></div>
                    <div class="hx-icon"><i class="bi bi-wallet2"></i></div>
                </div>
                <svg class="hx-spark" viewBox="0 0 120 36" preserveAspectRatio="none"><path pathLength="1" d="M0 26 L15 24 L30 18 L45 20 L60 12 L75 14 L90 6 L105 9 L120 3"/></svg>
            </div>
        </div>
    </div>

    <!-- ===== Biểu đồ doanh thu ===== -->
    <div class="row g-3 mb-3">
        <div class="col-12 anim" style="--d:.5s">
            <div class="hx-panel">
                <div class="hx-panel-head">
                    <div class="hx-title"><span class="hx-tag blue"><i class="bi bi-activity"></i></span>
                        <div><h6>Doanh thu 7 ngày gần nhất</h6><small>Đơn vị: triệu đồng · tính các đơn đã hoàn tất theo ngày nhận máy</small></div>
                    </div>
                    @if (Model.PhanTramTuan is decimal pt)
                    {
                        <span class="hx-badge">@((pt >= 0 ? "+" : "") + pt.ToString("0.#", inv))% so với tuần trước</span>
                    }
                    else
                    {
                        <span class="hx-badge">Chưa có dữ liệu tuần trước</span>
                    }
                </div>
                <div class="hx-bars">
                    @for (int n = 0; n < Model.Ngay7.Count; n++)
                    {
                        var ng = Model.Ngay7[n];
                        var cao = maxNgay > 0 ? Math.Max(4, (int)Math.Round(ng.GiaTri / maxNgay * 100)) : 4;
                        var dinh = maxNgay > 0 && ng.GiaTri == maxNgay;
                        <div class="hx-bar @(dinh ? "peak" : "")" style="--h:@(cao)%;--i:@n" data-v="@((ng.GiaTri / 1_000_000m).ToString("0.##", inv))"><span></span><em>@ng.Nhan</em></div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Đơn sửa chữa + cảnh báo tồn kho ===== -->
    <div class="row g-3">
        <div class="col-xl-8 anim anim-left" style="--d:.6s">
            <div class="hx-panel">
                <div class="hx-panel-head">
                    <div class="hx-title"><span class="hx-tag blue"><i class="bi bi-wrench-adjustable"></i></span>
                        <div><h6>Đơn sửa chữa gần đây</h6><small>@Model.DonGanDay.Count đơn mới nhất</small></div>
                    </div>
                    <a class="link-more" asp-controller="DonSuaChua" asp-action="Index">Xem tất cả <i class="bi bi-arrow-right"></i></a>
                </div>

                <div class="hx-orders">
                    @if (!Model.DonGanDay.Any())
                    {
                        <div class="empty-state"><i class="bi bi-wrench-adjustable"></i><b>Chưa có đơn sửa chữa nào</b></div>
                    }
                    @for (int d = 0; d < Model.DonGanDay.Count; d++)
                    {
                        var x = Model.DonGanDay[d];
                        var ten = x.TenKhach.Trim();
                        var chuCai = ten.Length > 0 ? ten.Split(' ').Last().Substring(0, 1).ToUpper() : "?";
                        var tong = x.CongTho + x.ChiTiets.Sum(c => c.SoLuong * c.DonGia);
                        var buoc = x.TrangThai == KhoLinhKien.Models.TrangThaiDon.HoanTat ? 3
                                 : x.TrangThai == KhoLinhKien.Models.TrangThaiDon.DangSua ? 2 : 1;
                        <a class="hx-row" style="--i:@d;text-decoration:none;color:inherit" asp-controller="DonSuaChua" asp-action="Details" asp-route-id="@x.Id">
                            <div class="avatar a@((d % 3) + 1)">@chuCai</div>
                            <div class="order-info"><b>@x.TenKhach</b><small>@x.TenMay · @x.MoTaLoi</small></div>
                            <div class="hx-steps s@(buoc)"><i></i><i></i><i></i></div>
                            <span class="pill @KhoLinhKien.Models.TrangThaiDon.Mau(x.TrangThai)"><i></i>@KhoLinhKien.Models.TrangThaiDon.Ten(x.TrangThai)</span>
                            <div class="order-money">
                                @if (tong > 0) { <b>@(tong.ToString("N0") + "đ")</b> } else { <b class="muted">Chưa báo giá</b> }
                                <small>#WO-@x.Id.ToString("D3")</small>
                            </div>
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-4 anim anim-right" style="--d:.7s">
            <div class="hx-panel">
                <div class="hx-panel-head">
                    <div class="hx-title"><span class="hx-tag red"><i class="bi bi-exclamation-triangle-fill"></i></span>
                        <div><h6>Cảnh báo tồn kho</h6><small>Cần nhập thêm</small></div>
                    </div>
                    <span class="count-pill">@Model.SapHetHang</span>
                </div>

                <div class="hx-alerts">
                    @if (!Model.CanhBao.Any())
                    {
                        <div class="empty-state"><i class="bi bi-check-circle"></i><b>Kho đang đủ hàng</b></div>
                    }
                    @for (int k = 0; k < Model.CanhBao.Count; k++)
                    {
                        var lk = Model.CanhBao[k];
                        var bat = lk.SoLuongTon <= 0 ? 0
                                : lk.TonToiThieu > 0 ? Math.Min(10, (int)Math.Ceiling(lk.SoLuongTon * 10.0 / lk.TonToiThieu)) : 0;
                        <div class="hx-alert" style="--i:@k">
                            <div class="stock-top">
                                <div class="stock-name"><b>@lk.TenLinhKien</b><small><i class="bi bi-geo-alt-fill"></i> @(lk.ViTriKho?.TenViTri ?? "Chưa gán vị trí")</small></div>
                                <div class="stock-qty"><b>@lk.SoLuongTon</b><span>/ @lk.TonToiThieu</span></div>
                            </div>
                            <div class="hx-seg">@for (int s = 0; s < 10; s++) { <i class="@(s < bat ? "on" : "")"></i> }</div>
                            <div class="stock-foot">
                                <span>@(lk.SoLuongTon == 0 ? "Hết hàng, nhập gấp" : "Rất thấp, nhập gấp")</span>
                                @if (quyenKho)
                                {
                                    <a asp-controller="PhieuNhap" asp-action="Create" class="btn-restock">Nhập thêm</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // Đồng hồ trực tuyến
            var clock = document.getElementById('hxClock');
            if (clock) {
                var tick = function () { clock.textContent = new Date().toLocaleTimeString('vi-VN', { hour12: false }); };
                tick(); setInterval(tick, 1000);
            }

            // Đếm số từ 0 lên
            document.querySelectorAll('[data-count]').forEach(function (el) {
                var end = parseFloat(el.dataset.count);
                var dec = parseInt(el.dataset.dec || 0, 10);
                var suffix = el.dataset.suffix || '';
                function show(v) {
                    el.textContent = v.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suffix;
                }
                if (reduce) { show(end); return; }
                var dur = 1500, start = null;
                setTimeout(function () {
                    requestAnimationFrame(function step(t) {
                        if (start === null) start = t;
                        var p = Math.min((t - start) / dur, 1);
                        show(end * (1 - Math.pow(1 - p, 3)));
                        if (p < 1) requestAnimationFrame(step);
                    });
                }, 300);
            });

            // Nghiêng 3D + vệt sáng theo chuột trên 4 thẻ thống kê
            if (!reduce) {
                document.querySelectorAll('.hx-card').forEach(function (card) {
                    card.addEventListener('mousemove', function (e) {
                        var r = card.getBoundingClientRect();
                        var px = (e.clientX - r.left) / r.width, py = (e.clientY - r.top) / r.height;
                        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
                        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
                        card.style.setProperty('--rx', ((py - .5) * -9) + 'deg');
                        card.style.setProperty('--ry', ((px - .5) * 11) + 'deg');
                    });
                    card.addEventListener('mouseleave', function () {
                        ['--mx', '--my', '--rx', '--ry'].forEach(function (k) { card.style.removeProperty(k); });
                    });
                });
            }
        })();
    </script>
}