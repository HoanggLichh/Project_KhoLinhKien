@model KhoLinhKien.Models.ViTriKho
@{
    ViewData["Title"] = "Vị trí " + Model.TenViTri;
    var canEdit = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");
    var ds = (List<KhoLinhKien.Models.LinhKien>)ViewBag.DanhSach;
    var chuaGan = (SelectList)ViewBag.ChuaGan;
    var i = 0;
}

<a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại danh sách vị trí</a>

<div class="page-head">
    <div class="d-flex align-items-center gap-3">
        <span class="loc-icon" style="width:56px;height:56px;font-size:1.6rem"><i class="bi bi-box-seam"></i></span>
        <div>
            <h1>@Model.TenViTri</h1>
            <p>@(string.IsNullOrWhiteSpace(Model.GhiChu) ? "Không có ghi chú" : Model.GhiChu) · <b>@ds.Count</b> linh kiện</p>
        </div>
    </div>
</div>

@if (canEdit && chuaGan.Any())
{
    <form asp-action="GanLinhKien" method="post" class="assign-box">
        <input type="hidden" name="viTriId" value="@Model.Id" />
        <select name="linhKienId" class="select-soft" asp-items="chuaGan"></select>
        <button type="submit" class="btn-primary-soft"><i class="bi bi-plus-circle"></i> Gán vào vị trí này</button>
    </form>
}

@if (!ds.Any())
{
    <div class="empty-state"><i class="bi bi-inbox"></i><b>Vị trí này đang trống</b><span>Chưa có linh kiện nào được gán.</span></div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th>Mã</th><th>Linh kiện</th><th>Loại</th><th>Tồn kho</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in ds)
                {
                    var tt = x.SoLuongTon <= 0 ? "wait" : x.SoLuongTon <= x.TonToiThieu ? "doing" : "done";
                    var nhan = x.SoLuongTon <= 0 ? "Hết hàng" : x.SoLuongTon <= x.TonToiThieu ? "Sắp hết" : "Đủ hàng";
                    <tr style="--i:@Math.Min(i++, 14)">
                        <td><span class="code-chip">@x.MaLinhKien</span></td>
                        <td class="cell-title"><b>@x.TenLinhKien</b></td>
                        <td><span class="tag">@x.LoaiLinhKien?.TenLoai</span></td>
                        <td><span class="pill @tt"><i></i>@nhan</span> <span class="num ms-2">@x.SoLuongTon</span></td>
                        <td>
                            <div class="actions">
                                <a class="icon-btn view" asp-controller="LinhKien" asp-action="Details" asp-route-id="@x.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                @if (canEdit)
                                {
                                    <form asp-action="BoLinhKien" method="post" class="d-inline">
                                        <input type="hidden" name="viTriId" value="@Model.Id" />
                                        <input type="hidden" name="linhKienId" value="@x.Id" />
                                        <button type="submit" class="icon-btn del" title="Bỏ khỏi vị trí"><i class="bi bi-box-arrow-right"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}