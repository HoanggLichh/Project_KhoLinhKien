@model IEnumerable<KhoLinhKien.Models.LinhKien>
@{
    ViewData["Title"] = "Quản lý linh kiện";
    var canEdit = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");
    var dsLoai = (SelectList)ViewData["LoaiId"]!;
    var dsViTri = (SelectList)ViewData["ViTriId"]!;
    var tuKhoa = ViewData["TuKhoa"] as string;
    var coLoc = !string.IsNullOrWhiteSpace(tuKhoa)
             || !string.IsNullOrEmpty(Context.Request.Query["loaiId"])
             || !string.IsNullOrEmpty(Context.Request.Query["viTriId"]);
    var i = 0;
}

<div class="page-head">
    <div>
        <h1>Quản lý linh kiện</h1>
        <p>Tra cứu, thêm mới và theo dõi tồn kho từng linh kiện</p>
    </div>
    @if (canEdit)
    {
        <a class="btn-add" asp-action="Create"><i class="bi bi-plus-lg"></i> Thêm linh kiện</a>
    }
</div>

<form method="get" class="toolbar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" name="tuKhoa" value="@tuKhoa" placeholder="Tìm theo mã hoặc tên linh kiện..." />
    </div>
    <select name="loaiId" class="select-soft" asp-items="dsLoai"><option value="">Tất cả loại</option></select>
    <select name="viTriId" class="select-soft" asp-items="dsViTri"><option value="">Tất cả vị trí</option></select>
    <button type="submit" class="btn-primary-soft"><i class="bi bi-funnel"></i> Lọc</button>
    @if (coLoc)
    {
        <a class="btn-soft" asp-action="Index"><i class="bi bi-x-lg"></i> Xóa lọc</a>
    }
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <b>@(coLoc ? "Không tìm thấy linh kiện phù hợp" : "Chưa có linh kiện nào")</b>
        <span>@(coLoc ? "Thử đổi từ khóa hoặc bỏ bộ lọc." : "Bấm Thêm linh kiện để bắt đầu.")</span>
    </div>
}
else
{
    <div class="result-count">Hiển thị <b>@Model.Count()</b> linh kiện</div>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Mã</th><th>Linh kiện</th><th>Loại</th><th>Vị trí</th>
                    <th>Đơn giá</th><th>Tồn kho</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    var tt = x.SoLuongTon <= 0 ? "wait" : x.SoLuongTon <= x.TonToiThieu ? "doing" : "done";
                    var nhan = x.SoLuongTon <= 0 ? "Hết hàng" : x.SoLuongTon <= x.TonToiThieu ? "Sắp hết" : "Đủ hàng";
                    <tr style="--i:@Math.Min(i++, 14)">
                        <td><span class="code-chip">@x.MaLinhKien</span></td>
                        <td class="cell-title">
                            <b>@x.TenLinhKien</b>
                            <small>@(string.IsNullOrWhiteSpace(x.DongMayTuongThich) ? "Chưa ghi dòng máy" : x.DongMayTuongThich)</small>
                        </td>
                        <td><span class="tag">@x.LoaiLinhKien?.TenLoai</span></td>
                        <td>
                            @if (x.ViTriKho != null) { <span class="tag"><i class="bi bi-geo-alt-fill"></i> @x.ViTriKho.TenViTri</span> }
                            else { <span class="tag muted">Chưa gán</span> }
                        </td>
                        <td class="num">@(x.DonGia.ToString("N0") + "đ")</td>
                        <td>
                            <span class="pill @tt"><i></i>@nhan</span>
                            <div class="cell-title"><small>@x.SoLuongTon / tối thiểu @x.TonToiThieu</small></div>
                        </td>
                        <td>
                            <div class="actions">
                                <a class="icon-btn view" asp-action="Details" asp-route-id="@x.Id" title="Xem chi tiết"><i class="bi bi-eye"></i></a>
                                @if (canEdit)
                                {
                                    <a class="icon-btn edit" asp-action="Edit" asp-route-id="@x.Id" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <button type="button" class="icon-btn del" title="Xóa"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-delete-url="@Url.Action("Delete", new { id = x.Id })"
                                            data-delete-name="@x.TenLinhKien"><i class="bi bi-trash3"></i></button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_PageTools" />