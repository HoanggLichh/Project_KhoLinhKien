@model KhoLinhKien.Models.LinhKien
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Sửa linh kiện";
    var dsLoai = (SelectList)ViewData["LoaiLinhKienId"]!;
    var dsViTri = (SelectList)ViewData["ViTriKhoId"]!;
}

<div class="fm-wrap">
    <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>

    <div class="page-head">
        <div>
            <h1>Sửa linh kiện</h1>
            <p>Cập nhật thông tin của <b>@Model.MaLinhKien</b>.</p>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="fm-card">
        <div asp-validation-summary="ModelOnly" class="fm-err"></div>
        <input type="hidden" asp-for="Id" />

        <div class="fm-grid">
            <div class="fm-field">
                <label asp-for="MaLinhKien">Mã linh kiện</label>
                <input asp-for="MaLinhKien" class="form-ctl" autocomplete="off" />
                <span asp-validation-for="MaLinhKien" class="fm-err"></span>
            </div>

            <div class="fm-field">
                <label asp-for="TenLinhKien">Tên linh kiện</label>
                <input asp-for="TenLinhKien" class="form-ctl" autocomplete="off" />
                <span asp-validation-for="TenLinhKien" class="fm-err"></span>
            </div>

            <div class="fm-field">
                <label asp-for="LoaiLinhKienId">Loại linh kiện</label>
                <select asp-for="LoaiLinhKienId" class="form-select" asp-items="dsLoai"></select>
                <span asp-validation-for="LoaiLinhKienId" class="fm-err"></span>
            </div>

            <div class="fm-field">
                <label asp-for="ViTriKhoId">Vị trí kho</label>
                <select asp-for="ViTriKhoId" class="form-select" asp-items="dsViTri"></select>
                <span asp-validation-for="ViTriKhoId" class="fm-err"></span>
            </div>

            <div class="fm-field full">
                <label asp-for="DongMayTuongThich">Dòng máy tương thích</label>
                <input asp-for="DongMayTuongThich" class="form-ctl" autocomplete="off" />
                <span class="fm-hint">Ví dụ: iPhone 12, Samsung S22.</span>
                <span asp-validation-for="DongMayTuongThich" class="fm-err"></span>
            </div>

            <div class="fm-field">
                <label asp-for="DonGia">Đơn giá (đồng)</label>
                <input asp-for="DonGia" class="form-ctl" inputmode="decimal" autocomplete="off" />
                <span asp-validation-for="DonGia" class="fm-err"></span>
            </div>

            <div class="fm-field">
                <label asp-for="TonToiThieu">Tồn tối thiểu</label>
                <input asp-for="TonToiThieu" class="form-ctl" inputmode="numeric" autocomplete="off" />
                <span class="fm-hint">Dùng để cảnh báo linh kiện sắp hết.</span>
                <span asp-validation-for="TonToiThieu" class="fm-err"></span>
            </div>
        </div>

        <p class="fm-note"><i class="bi bi-info-circle"></i> Số lượng tồn không sửa ở đây, chỉ thay đổi qua phiếu nhập kho và đơn sửa chữa.</p>

        <div class="fm-actions">
            <button type="submit" class="btn-add"><i class="bi bi-check2"></i> Lưu thay đổi</button>
            <a class="btn-soft" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>