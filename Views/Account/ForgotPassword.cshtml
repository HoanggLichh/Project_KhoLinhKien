@model KhoLinhKien.Controllers.ForgotPasswordViewModel
@{ ViewData["Title"] = "Quên mật khẩu"; }

<div class="aurora" aria-hidden="true"><span></span><span></span></div>

<section class="auth-wrap">
    <div class="auth-card">
        <h1 class="auth-title">Quên mật khẩu</h1>
        <p class="auth-sub">Nhập email để nhận liên kết đặt lại mật khẩu</p>

       @{
        var daGui = ViewData["DaGui"] as bool? ?? false;
        var devLink = ViewData["DevLink"] as string;
    }

    @if (daGui)
    {
        <div class="auth-ok">
            <span>Nếu email tồn tại, liên kết đặt lại mật khẩu đã được tạo.</span>
            @if (!string.IsNullOrEmpty(devLink))
            {
                <p style="margin:.8rem 0 0">
                    <b>(Chế độ demo)</b>
                    <a href="@devLink">Bấm vào đây để đặt lại mật khẩu</a>
                </p>
            }
        </div>
    }

        <form asp-action="ForgotPassword" method="post" novalidate>
            <div class="auth-field">
                <label asp-for="Email">Email</label>
                <div class="auth-input">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="auth-ctl" autofocus autocomplete="email" placeholder="ten@email.com" />
                </div>
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>
            <button type="submit" class="btn-auth">Gửi liên kết <i class="bi bi-arrow-right"></i></button>
        </form>

        <p class="auth-switch"><a asp-action="Login">← Quay lại đăng nhập</a></p>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }