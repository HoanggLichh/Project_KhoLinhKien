@model KhoLinhKien.Models.NhaCungCap
@{
    var isEdit = (string?)ViewContext.RouteData.Values["action"] == "Edit";
    var actionName = isEdit ? "Edit" : "Create";
    var iconClass = isEdit ? "bi-pencil-square" : "bi-plus-circle-fill";
}

<a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>

<div class="form-card" style="max-width:680px">
    <div class="form-card-head">
        <span class="fc-icon"><i class="bi @iconClass"></i></span>
        <div><h4>@(isEdit ? "Sửa nhà cung cấp" : "Thêm nhà cung cấp")</h4><small>Ô có dấu * là bắt buộc</small></div>
    </div>
    <form asp-action="@actionName" method="post">
        <div asp-validation-summary="ModelOnly" class="form-alert"></div>
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }
        <div class="form-body">
            <div class="field full">
                <label asp-for="TenNhaCungCap">Tên nhà cung cấp <span class="req">*</span></label>
                <div class="input-icon">
                    <i class="bi bi-shop"></i>
                    <input asp-for="TenNhaCungCap" class="form-ctl" placeholder="VD: Công ty Linh kiện ABC" />
                </div>
                <span asp-validation-for="TenNhaCungCap" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="SoDienThoai">Số điện thoại</label>
                <div class="input-icon">
                    <i class="bi bi-telephone"></i>
                    <input asp-for="SoDienThoai" class="form-ctl" inputmode="tel" placeholder="VD: 0901234567" />
                </div>
                <span asp-validation-for="SoDienThoai" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="DiaChi">Địa chỉ</label>
                <div class="input-icon">
                    <i class="bi bi-geo-alt"></i>
                    <input asp-for="DiaChi" class="form-ctl" placeholder="VD: 12 Nguyễn Trãi, Quận 5" />
                </div>
                <span asp-validation-for="DiaChi" class="field-error"></span>
            </div>
        </div>
        <div class="form-foot">
            <a class="btn-cancel" asp-action="Index">Hủy</a>
            <button type="submit" class="btn-save"><i class="bi bi-check2-circle"></i> Lưu</button>
        </div>
    </form>
</div>