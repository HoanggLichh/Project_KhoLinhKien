@model IEnumerable<KhoLinhKien.Models.LoaiLinhKien>
@{
    ViewData["Title"] = "Loại linh kiện";
    var coQuyen = User.IsInRole("QuanLy") || User.IsInRole("ThuKho");
}

<h1>Loại linh kiện</h1>

@if (coQuyen)
{
    <p><a asp-action="Create" class="btn btn-primary">Thêm loại mới</a></p>
}

<table class="table table-striped">
    <thead>
        <tr><th>Tên loại</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.TenLoai</td>
            <td>
                @if (coQuyen)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>