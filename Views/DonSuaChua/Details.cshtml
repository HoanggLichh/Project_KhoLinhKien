@model KhoLinhKien.Models.DonSuaChua
@{
    ViewData["Title"] = "Đơn WO-" + Model.Id.ToString("D3");
    var tienLk = Model.ChiTiets.Sum(c => c.SoLuong * c.DonGia);
    var tong = tienLk + Model.CongTho;
    var stt = 0;
    var conSua = Model.TrangThai != KhoLinhKien.Models.TrangThaiDon.HoanTat;
    var linhKiens = ViewData["LinhKiens"] as List<KhoLinhKien.Models.LinhKienChonVM>;
     var duocXuLy = User.IsInRole("QuanLy") || User.IsInRole("KyThuatVien");
    var buoc = Model.TrangThai == KhoLinhKien.Models.TrangThaiDon.HoanTat ? 2
             : Model.TrangThai == KhoLinhKien.Models.TrangThaiDon.DangSua ? 1 : 0;
}

<a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại danh sách đơn</a>

<div class="detail-card" style="margin-bottom:1rem">
    <span class="code-chip">WO-@Model.Id.ToString("D3")</span>
    <span class="pill @KhoLinhKien.Models.TrangThaiDon.Mau(Model.TrangThai)" style="margin-left:.5rem"><i></i>@KhoLinhKien.Models.TrangThaiDon.Ten(Model.TrangThai)</span>
    <h2>@Model.TenMay</h2>
    <div class="detail-grid">
        <div class="detail-item"><small>Khách hàng</small><b>@Model.TenKhach</b></div>
        <div class="detail-item"><small>Số điện thoại</small><b>@Model.SoDienThoai</b></div>
        <div class="detail-item"><small>Ngày nhận</small><b>@Model.NgayNhan.ToString("dd/MM/yyyy")</b></div>
        <div class="detail-item"><small>Người lập đơn</small><b>@(Model.NguoiLap ?? "—")</b></div>
        <div class="detail-item" style="grid-column:1/-1"><small>Mô tả lỗi</small><b>@Model.MoTaLoi</b></div>
    </div>

    <div class="status-bar">
    <div class="steps">
        <span class="step @(buoc == 2 || 0 < buoc ? "done" : "now")">1. Nhận máy</span>
        <span class="step @(buoc == 2 ? "done" : buoc == 1 ? "now" : "")">2. Đang sửa</span>
        <span class="step @(buoc == 2 ? "done" : "")">3. Hoàn tất</span>
    </div>

    @if (duocXuLy && buoc == 0)
    {
        <form asp-action="DoiTrangThai" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="trangThai" value="DangSua" />
            <button type="submit" class="btn-save"><i class="bi bi-play-circle"></i> Bắt đầu sửa</button>
        </form>
    }
    else if (duocXuLy && buoc == 1)
    {
        <form asp-action="DoiTrangThai" method="post" onsubmit="return confirm('Hoàn tất đơn này? Sau đó không thể sửa linh kiện và tiền công nữa.');">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="trangThai" value="HoanTat" />
            <button type="submit" class="btn-save"><i class="bi bi-check2-circle"></i> Hoàn tất đơn</button>
        </form>
    }
    else if (buoc == 2)
    {
        <span class="text-muted">Đơn đã hoàn tất, không thể thay đổi.</span>
    }
</div>

</div>

<h6 class="fw-bold mb-2">Linh kiện đã dùng</h6>

@if (conSua && linhKiens != null)
{
        <form asp-action="ThemLinhKien" asp-route-id="@Model.Id" method="post" class="issue-form" novalidate>
        <div class="issue-field grow">
            <label>Linh kiện</label>
            <select name="linhKienId" id="lkSelect" class="form-ctl">
                <option value="0">-- Chọn linh kiện cần xuất --</option>
                @foreach (var lk in linhKiens)
                {
                    if (lk.Ton > 0)
                    {
                        <option value="@lk.Id" data-ton="@lk.Ton" data-gia="@((long)lk.DonGia)">@lk.Ten (tồn @lk.Ton)</option>
                    }
                    else
                    {
                        <option value="@lk.Id" disabled>@lk.Ten (hết hàng)</option>
                    }
                }
            </select>
        </div>
        <div class="issue-field">
            <label>Số lượng</label>
            <input type="number" name="soLuong" id="lkSoLuong" class="form-ctl" min="1" value="1" />
        </div>
        <button type="submit" class="btn-save"><i class="bi bi-box-arrow-up"></i> Xuất cho đơn</button>
        
    </form>
    <div id="lkInfo" class="text-muted" style="margin:.4rem 0 1rem;font-size:.9rem"></div>
}

@if (!Model.ChiTiets.Any())
{
    <div class="empty-state"><i class="bi bi-cpu"></i><b>Chưa xuất linh kiện cho đơn này</b></div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl" style="min-width:0">
            <thead><tr><th>STT</th><th>Linh kiện</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th>@if (conSua){<th></th>}</tr></thead>
            <tbody>
                @foreach (var c in Model.ChiTiets)
                {
                    <tr>
                        <td class="num">@(++stt)</td>
                        <td class="cell-title"><b>@c.LinhKien?.TenLinhKien</b><small>@c.LinhKien?.MaLinhKien</small></td>
                        <td class="num">@c.SoLuong</td>
                        <td>@(c.DonGia.ToString("N0") + "đ")</td>
                        <td class="num">@((c.SoLuong * c.DonGia).ToString("N0") + "đ")</td>
                        @if (conSua)
                        {
                            <td>
                                <form asp-action="XoaDong" method="post" onsubmit="return confirm('Bỏ dòng này khỏi đơn? Số lượng sẽ được hoàn lại vào kho.');">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="chiTietId" value="@c.Id" />
                                    <button type="submit" class="icon-btn del" title="Bỏ dòng và hoàn kho"><i class="bi bi-x-lg"></i></button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (conSua && duocXuLy)
{
    <form asp-action="CapNhatCong" asp-route-id="@Model.Id" method="post" class="issue-form" style="margin-top:1rem">
        <div class="issue-field grow">
            <label>Tiền công thợ (đ)</label>
            <input type="number" name="congTho" class="form-ctl" min="0" step="1000" value="@((long)Model.CongTho)" />
        </div>
        <button type="submit" class="btn-save"><i class="bi bi-save"></i> Lưu tiền công</button>
    </form>
}

<div class="total-bar">
    <span>Tiền linh kiện: <b>@(tienLk.ToString("N0") + "đ")</b></span>
    <span>Tiền công: <b>@(Model.CongTho.ToString("N0") + "đ")</b></span>
    <span>Tổng cộng: <b>@(tong.ToString("N0") + "đ")</b></span>
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('lkSelect');
            if (!sel) return;
            var sl = document.getElementById('lkSoLuong');
            var info = document.getElementById('lkInfo');
            sel.addEventListener('change', function () {
                var o = sel.options[sel.selectedIndex];
                if (o.dataset.ton) {
                    sl.max = o.dataset.ton;
                    info.textContent = 'Tồn hiện tại: ' + o.dataset.ton + ' · Giá: ' + Number(o.dataset.gia).toLocaleString('en-US') + 'đ';
                } else {
                    sl.removeAttribute('max');
                    info.textContent = '';
                }
            });
        })();
    </script>
}