@{ ViewData["Title"] = "Trang chủ"; }

<section class="hero mb-4">
    <h1>Quản lý kho linh kiện điện thoại</h1>
    <p>Nhập kho, theo dõi tồn, tra cứu vị trí và quản lý đơn sửa chữa trong một hệ thống.</p>
    @if (!User.Identity!.IsAuthenticated)
    {
        <a class="btn btn-accent btn-lg" asp-area="Identity" asp-page="/Account/Login">ĐĂNG NHẬP</a>
    }
    else
    {
        <a class="btn btn-accent btn-lg" asp-controller="LinhKien" asp-action="Index">XEM LINH KIỆN</a>
    }
</section>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="benefit"><i class="bi bi-shield-check"></i><div><b>Phân quyền rõ ràng</b><div class="small text-muted">Quản lý, Thủ kho, Kỹ thuật viên</div></div></div></div>
    <div class="col-md-4"><div class="benefit"><i class="bi bi-box-seam"></i><div><b>Tồn kho chính xác</b><div class="small text-muted">Chỉ đổi qua phiếu nhập hoặc đơn sửa</div></div></div></div>
    <div class="col-md-4"><div class="benefit"><i class="bi bi-bell"></i><div><b>Cảnh báo tồn thấp</b><div class="small text-muted">Biết trước khi hết linh kiện</div></div></div></div>
</div>

@if (User.IsInRole("QuanLy") || User.IsInRole("ThuKho"))
{
    <h4 class="section-title">Chức năng chính</h4>
    <div class="row g-3">
        <div class="col-6 col-md-3"><a class="text-decoration-none" asp-controller="LinhKien" asp-action="Index"><div class="card-box p-4 text-center"><i class="bi bi-motherboard fs-1 text-warning"></i><h6 class="mt-2 text-dark">Linh kiện</h6></div></a></div>
        <div class="col-6 col-md-3"><a class="text-decoration-none" asp-controller="LoaiLinhKien" asp-action="Index"><div class="card-box p-4 text-center"><i class="bi bi-tags fs-1 text-warning"></i><h6 class="mt-2 text-dark">Loại linh kiện</h6></div></a></div>
        <div class="col-6 col-md-3"><a class="text-decoration-none" asp-controller="NhaCungCap" asp-action="Index"><div class="card-box p-4 text-center"><i class="bi bi-truck fs-1 text-warning"></i><h6 class="mt-2 text-dark">Nhà cung cấp</h6></div></a></div>
        <div class="col-6 col-md-3"><a class="text-decoration-none" asp-controller="ViTriKho" asp-action="Index"><div class="card-box p-4 text-center"><i class="bi bi-boxes fs-1 text-warning"></i><h6 class="mt-2 text-dark">Vị trí kho</h6></div></a></div>
    </div>
}
